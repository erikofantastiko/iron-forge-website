---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Iron Forge · Workout tracking for serious lifters"
    description="Workout tracking for serious lifters. Log drop sets, supersets, myo-reps and giant sets exactly as you programme them. No AI coaching. No feed, no followers, no leaderboards. No ads, ever."
    canonicalUrl="https://ironforge.app/"
>
    <Fragment slot="head">
        <!-- Additional SEO -->
        <meta name="keywords" content="workout app, fitness tracker, drop sets, supersets, myo-reps, giant sets, progressive overload, gym app, iOS workout app" />
        <meta property="og:url" content="https://ironforge.app/" />
        <meta name="twitter:url" content="https://ironforge.app/" />

        <!-- Structured Data (JSON-LD) -->
        <script type="application/ld+json" is:inline>
        {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "Iron Forge",
            "applicationCategory": "HealthApplication",
            "operatingSystem": "iOS",
            "description": "Workout tracking for serious lifters. Log drop sets, supersets, myo-reps and giant sets exactly as you programme them.",
            "url": "https://ironforge.app",
            "logo": "https://ironforge.app/Logo.png",
            "author": {
                "@type": "Person",
                "name": "Erik"
            }
        }
        </script>
    </Fragment>

    <!-- Header -->
    <header>
        <div class="wrap header-in">
            <div class="brand">
                <picture>
                    <source srcset="/Logo.webp" type="image/webp" />
                    <img src="/Logo.png" alt="Iron Forge" width="34" height="34" />
                </picture>
                <span class="wm">IRON FORGE</span>
            </div>
            <span class="status"><span class="dot" aria-hidden="true"></span>Pre-launch · iOS</span>
        </div>
    </header>

    <!-- Hero -->
    <section class="hero">
        <div class="wrap">
            <span class="eyebrow">Workout tracking · iOS</span>
            <h1>Track how you actually train.<span class="b">Not how apps think you should.</span></h1>
            <p class="sub">Built by a lifter, for lifters who train with drop sets, supersets, myo-reps and giant sets.</p>

            <!-- Waitlist Form - Kit Embed -->
            <div class="cta">
                <script is:inline src="https://f.convertkit.com/ckjs/ck.5.js"></script>
                <form
                    action="https://app.kit.com/forms/8869648/subscriptions"
                    class="seva-form formkit-form"
                    method="post"
                    data-sv-form="8869648"
                    data-uid="f1beae323b"
                    data-format="inline"
                    data-version="5"
                    data-options='{"settings":{"after_subscribe":{"action":"redirect","redirect_url":"https://ironforge.app/thanks","success_message":"You are on the list. We will email you when Iron Forge launches on iOS."}}}'
                >
                    <div data-style="clean">
                        <ul
                            class="formkit-alert formkit-alert-error"
                            data-element="errors"
                            data-group="alert"
                        >
                        </ul>
                        <div
                            data-element="fields"
                            data-stacked="false"
                            class="seva-fields formkit-fields"
                        >
                            <div class="formkit-field">
                                <input
                                    class="formkit-input"
                                    name="email_address"
                                    aria-label="Email Address"
                                    placeholder="you@example.com"
                                    required=""
                                    type="email"
                                />
                            </div>
                            <button
                                data-element="submit"
                                class="formkit-submit"
                            >
                                <div class="formkit-spinner">
                                    <div></div><div></div><div></div>
                                </div>
                                <span>Join Waitlist</span>
                            </button>
                        </div>
                    </div>
                </form>
                <p class="form-note">Waitlist for launch. No spam, just launch updates.</p>
            </div>
        </div>
    </section>

    <!-- Why / manifesto -->
    <div class="wrap">
        <div class="section">
            <h2 class="eyebrow">Why</h2>
            <p class="lead">Every other app is racing towards AI coaching and social feeds. <span class="dim">Iron Forge does the opposite: it tracks how you actually train, exactly as you programme it.</span></p>
        </div>

        <!-- Spec sheet -->
        <div class="section">
            <h2 class="eyebrow">What it does</h2>
            <div class="spec">
                <div class="row"><div class="k">Methods</div><div class="v"><b>Drop sets, supersets, myo-reps and giant sets.</b> Logged as structures, not workarounds. Drop sets run one set into the next at a lighter weight. Myo-reps add volume: one hard set, then short rests and more reps at the same weight.</div></div>
                <div class="row"><div class="k">Supersets</div><div class="v">Two exercises back to back with no rest. Set up each one on its own: different exercises, reps, loads and set counts.</div></div>
                <div class="row"><div class="k">Giant sets</div><div class="v">Three or more exercises back to back. Each one can run its own number of rounds.</div></div>
                <div class="row"><div class="k">Recovery</div><div class="v">HRV (heart-rate variability, a recovery signal), sleep and resting heart rate from Apple Health, scored into a daily readiness number. Evidence-aligned.</div></div>
                <div class="row"><div class="k">Progression</div><div class="v">Plateau detection across your last six logged sessions, then a suggested target weight and reps. It suggests, it does not decide.</div></div>
                <div class="row"><div class="k">RPE</div><div class="v">Rate of perceived exertion, how hard a set felt. Logged per exercise, by hand. Nothing auto-calculated.</div></div>
                <div class="row"><div class="k">Library</div><div class="v">1,300+ exercises with animations.</div></div>
            </div>
        </div>
    </div>

    <!-- Refusal -->
    <section class="refusal">
        <div class="wrap">
            <h2 class="eyebrow">What it leaves out</h2>
            <div class="big">No AI coaching. No feed, no followers, no leaderboards. <span class="dim">No ads, ever.</span></div>
            <p>Just precise tracking for people who do not need motivation, only data.</p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="wrap">
            <div class="foot">
                <div class="about">
                    <strong>Built by Erik</strong>
                    <span>Lifter, dad and pilot. Based in Austria.</span>
                </div>
                <div class="links">
                    <a href="/privacy">Privacy</a><span class="sep" aria-hidden="true">·</span>
                    <a href="/legal">Legal</a><span class="sep" aria-hidden="true">·</span>
                    <a
                        href="https://www.instagram.com/ironforge.app/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Follow Iron Forge on Instagram"
                    >Instagram</a>
                </div>
            </div>
            <div class="foot-base">
                <span class="sig">ironforge.app</span>
                <span class="cr">© 2026 Iron Forge · Alland, Austria</span>
            </div>
        </div>
    </footer>
</Layout>

<style>
    .eyebrow{
        font-family:"DM Mono",monospace;font-size:.82rem;font-weight:500;letter-spacing:.2em;
        text-transform:uppercase;color:var(--text-muted);margin:0;
    }

    .wrap{max-width:1080px;margin:0 auto;padding:0 40px;}

    /* Header */
    header{border-bottom:1px solid var(--surface-border);}
    .header-in{display:flex;align-items:center;justify-content:space-between;padding:22px 0;}
    .brand{display:flex;align-items:center;gap:11px;}
    .brand img{width:34px;height:34px;display:block;}
    .brand .wm{font-weight:700;font-size:1.05rem;letter-spacing:0.12em;color:var(--text-primary);}
    .status{
        display:inline-flex;align-items:center;gap:8px;font-family:"DM Mono",monospace;
        font-size:.78rem;letter-spacing:.15em;text-transform:uppercase;color:var(--text-muted);
    }
    .status .dot{width:6px;height:6px;border-radius:50%;background:var(--red);}

    /* Hero */
    .hero{padding:104px 0 96px;border-bottom:1px solid var(--surface-border);}
    .hero .eyebrow{display:block;margin-bottom:26px;}
    h1{
        font-weight:600;font-size:clamp(2.9rem,6.4vw,5.1rem);line-height:1.02;
        letter-spacing:-0.038em;max-width:16ch;color:var(--text-primary);
    }
    h1 .b{display:block;color:var(--text-secondary);font-weight:500;}
    .hero p.sub{margin-top:30px;max-width:52ch;font-size:1.28rem;color:var(--text-secondary);line-height:1.58;}

    /* Waitlist (Kit form) */
    .cta{margin-top:46px;max-width:540px;}
    .formkit-form{background:transparent;}
    /* .formkit-alert* live in global.css: Kit injects the success node at runtime,
       which Astro's component-scoped styles cannot reach. */
    .formkit-fields{display:flex;gap:10px;flex-wrap:wrap;margin:0;}
    .formkit-field{flex:1;min-width:240px;margin:0;}
    .formkit-input{
        width:100%;background:transparent;color:var(--text-primary);
        border:1px solid var(--surface-border-strong);border-radius:var(--radius-md);padding:15px 17px;
        font-family:"DM Sans",sans-serif;font-size:1.05rem;outline:none;transition:border-color .18s;
    }
    .formkit-input::placeholder{color:var(--text-muted);}
    .formkit-input:focus{border-color:var(--text-secondary);}
    .formkit-submit{
        background:var(--red);color:var(--text-primary);border:none;border-radius:var(--radius-md);padding:15px 28px;
        font-family:"DM Sans",sans-serif;font-weight:600;font-size:1.03rem;cursor:pointer;
        transition:background .18s;white-space:nowrap;
    }
    .formkit-submit:hover{background:var(--red-deep);}
    .formkit-submit:disabled{opacity:.7;cursor:not-allowed;}
    .form-note{
        margin-top:13px;font-family:"DM Mono",monospace;font-size:.84rem;
        letter-spacing:.02em;color:var(--text-muted);
    }

    /* Editorial two-column section */
    .section{
        display:grid;grid-template-columns:200px 1fr;gap:48px;
        padding:66px 0;border-bottom:1px solid var(--surface-border);
    }
    .section > .eyebrow{padding-top:8px;}

    .lead{
        font-size:1.78rem;font-weight:500;line-height:1.4;letter-spacing:-0.02em;
        max-width:30ch;color:var(--text-primary);
    }
    .lead .dim{color:var(--text-secondary);}

    /* Spec sheet */
    .spec{display:flex;flex-direction:column;}
    .spec .row{
        display:grid;grid-template-columns:165px 1fr;gap:30px;
        padding:24px 0;border-top:1px solid var(--surface-border);align-items:start;
    }
    .spec .row:first-child{border-top:none;padding-top:0;}
    .spec .k{
        font-family:"DM Mono",monospace;font-size:.83rem;letter-spacing:.13em;
        text-transform:uppercase;color:var(--red);padding-top:4px;
    }
    .spec .v{font-size:1.17rem;color:var(--text-secondary);line-height:1.55;max-width:56ch;}
    .spec .v b{color:var(--text-primary);font-weight:600;}

    /* Refusal */
    .refusal{padding:98px 0;border-bottom:1px solid var(--surface-border);}
    .refusal .eyebrow{display:block;margin-bottom:28px;}
    .refusal .big{
        font-size:clamp(2rem,3.8vw,3.05rem);font-weight:600;
        letter-spacing:-0.03em;line-height:1.14;max-width:20ch;color:var(--text-primary);
    }
    .refusal .big .dim{color:var(--text-secondary);}
    .refusal p{margin-top:26px;max-width:48ch;color:var(--text-secondary);font-size:1.2rem;line-height:1.58;}

    /* Footer */
    footer{padding:54px 0 66px;}
    .foot{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap;}
    .foot .about strong{display:block;font-weight:600;font-size:1rem;margin-bottom:3px;color:var(--text-primary);}
    .foot .about span{color:var(--text-muted);font-size:.92rem;}
    .foot .links{display:flex;gap:14px;align-items:center;font-size:.95rem;}
    .foot .links a{color:var(--text-secondary);text-decoration:none;transition:color .18s;}
    .foot .links a:hover{color:var(--text-primary);text-decoration:none;}
    .foot .sep{color:var(--surface-border-strong);}
    .foot-base{
        display:flex;justify-content:space-between;align-items:center;gap:16px;
        margin-top:40px;padding-top:22px;border-top:1px solid var(--surface-border);flex-wrap:wrap;
    }
    .foot-base .sig{font-family:"DM Mono",monospace;font-size:.95rem;color:var(--text-secondary);letter-spacing:.02em;}
    .foot-base .cr{font-family:"DM Mono",monospace;font-size:.78rem;color:var(--text-muted);letter-spacing:.05em;}

    @media (max-width:760px){
        .wrap{padding:0 22px;}
        .hero{padding:72px 0 60px;}
        h1{font-size:clamp(2.5rem,9vw,3.2rem);}
        .section{grid-template-columns:1fr;gap:16px;padding:46px 0;}
        .spec .row{grid-template-columns:1fr;gap:7px;padding:22px 0;}
        .refusal{padding:66px 0;}
        .foot{flex-direction:column;gap:20px;}
    }
</style>
